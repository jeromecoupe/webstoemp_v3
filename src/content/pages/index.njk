---
permalink: /index.html
---

{% extends "layouts/base.njk" %}

{% from "macros/blogcard.njk" import blogcard %}

{% set metaTitle = "Home" %}
{% set metaDescription = "Portfolio and blog of Jérôme Coupé, belgian designer, developer and teacher based in Brussels." %}
{% set metaImage = "/assets/img/metaimage.png" %}

{% set colorTheme = "green" %}
{% set currentSection = "home" %}
{% set bannerImage = "resist.jpg" %}

{% block content %}

      <div class="c-homeintro">
        <div class="c-homeintro__text">
          <h1 class="c-homeintro__suptitle">Design, Code & Ramblings</h1>
          <p class="c-homeintro__manifesto">
            Frontend designer resisting the trend to <span>use divs for everything</span> since 1998.
          </p>
        </div>
        <div class="c-homeintro__media">
          <img src="/assets/img/homebanners/1024x768/{{ bannerImage }}"
               class="c-homeintro__img"
               width="1024"
               height="768"
               alt="Guys protesting with megaphones on a green and yellow smoke background">
        </div>
      </div>

  <div class="c-section">
    <div class="l-container">

      <div class="c-section__block">
        <div class="l-split l-split--colgap l-split--half@md">
          <div>
            <h2 class="c-smalltitle">Who's this ?</h2>
          </div>
          <div>
              <p>Webstoemp is the web home of Jérôme Coupé, designer, front-end developer and teacher from Brussels, Belgium. When not coding a website or teaching, chances are I am enjoying a few beers with friends or a gravel ride in the nearby woods.</p>
              <p>Although I work on web apps too, I have a soft spot for building content-oriented websites. To me, Internet will always be a way to share information before being an application runtime.</p>
              <p>
                <a class="c-ctalink" href="#">More about me</a>
              </p>
          </div>
        </div>
      </div>

      <div class="c-section__block">
        <h2 class="c-smalltitle">Latest blogposts</h2>
        {% set items = collections.blogposts | limit(4) %}
        {% for item in items %}
          {% if loop.first %}<ul class="l-grid l-grid--gap l-grid--2cols@sm l-grid--4cols@lg">{% endif %}
            <li>
              {{ blogcard({
                title: item.data.title,
                url: item.url,
                image: item.data.image,
                imageAlt: item.data.imageAlt,
                date: item.date
              }) }}
            </li>
          {% if loop.last %}</ul>{% endif %}
        {% endfor %}
        <p class="u-mbs-md"><a class="c-ctalink" href="#">All blogposts</a></p>
      </div>

    </div>
  </div>
  
{% endblock %}